# =============================================================================
# REQUIRED FOR LOCAL DEMO
# Compose supplies these same defaults when no .env file exists.
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO

FRONTEND_PORT=3000
BACKEND_PORT=8000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=renewi_access
POSTGRES_USER=renewi
POSTGRES_PORT=5432
# Intentionally empty: local Compose uses development-only trust authentication.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://renewi@postgres:5432/renewi_access

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

DEMO_MODE=true
DEMO_TIMEZONE=Europe/Amsterdam
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=renewi_session
SESSION_TTL_SECONDS=28800

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/var/lib/renewi/evidence
OCR_PROVIDER=mock
IDENTITY_VERIFIER_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
AUTH_PROVIDER=demo

# The signing key remains process-local when empty. The committed password is
# deliberately demo-only so the seeded accounts work without external secrets.
# Override both values outside this isolated manager-demo environment.
APP_SECRET_KEY=
DEMO_SEED_PASSWORD=renewi-demo-access

# =============================================================================
# OPTIONAL INTEGRATIONS
# Leave these empty to retain deterministic local/mock behavior.
# =============================================================================

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

IDENTITY_PROVIDER_API_URL=
IDENTITY_PROVIDER_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
